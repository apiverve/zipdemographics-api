{
    "name": "apiverve/zipdemographics",
    "description": "ZIP Demographics is a demographic data API for any US ZIP code, built on the US Census American Community Survey. Every plan gets total population and median household income, while paid plans add age, per-capita income, education, housing, employment, and racial composition.",
    "version": "1.2.3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "zipdemographics",
        "demographics api",
        "demographic data api",
        "zip code demographics",
        "demographics by zip code api",
        "census data api"
    ],
    "homepage": "https://apiverve.com/marketplace/zipdemographics?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/zipdemographics",
        "source": "https://github.com/apiverve/zipdemographics-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Zipdemographics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Zipdemographics\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
